{
  "_说明": "配置模板：复制为 config.json 后按需修改。config.json 已被 gitignore，避免把 accessToken 等本地配置提交进仓库；源码运行不复制也能启动（使用默认值并自动探测 git remote）。",
  "port": 3210,
  "host": "127.0.0.1",
  "repoRoot": "..",
  "imageRoot": "LTYpicture",
  "repo": {
    "owner": "Eiheir",
    "name": "Luo_Tianyi_Image",
    "branch": "main"
  },
  "classify": {
    "avatarRatioMax": 1.2,
    "wallpaperDir": "wallpapers&illustration",
    "emoticonDir": "emoticon",
    "temporaryDir": "wallpapers&illustration/temporary"
  },
  "naming": {
    "padding": 4,
    "emoticonPadding": 3,
    "allowedExt": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "bmp",
      "webp",
      "avif",
      "heic",
      "heif"
    ]
  },
  "dedup": {
    "hammingThreshold": 7,
    "cropThreshold": 5,
    "onExactDuplicate": "skip",
    "keepPriority": [
      "heng",
      "avatar",
      "shu"
    ]
  },
  "upload": {
    "maxBatchFiles": 500,
    "maxFileMB": 60,
    "quality": 95
  },
  "git": {
    "enabled": true,
    "timeoutMs": 120000,
    "purgeCdn": true
  },
  "linkFormat": "jsdelivr",
  "accessToken": ""
}
