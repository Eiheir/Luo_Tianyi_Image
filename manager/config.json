{
  "_说明": "以下为本模块独立配置文件，仅被 manager 模块读取，与原有图床零耦合",
  "port": 3210,
  "host": "127.0.0.1",
  "repoRoot": "..",
  "imageRoot": "LTYpicture",
  "repo": {
    "owner": "Eiheir",
    "name": "Luo_Tianyi_Image",
    "branch": "main"
  },
  "classify": {
    "avatarRatioMax": 1.2,
    "wallpaperDir": "wallpapers&illustration",
    "emoticonDir": "emoticon",
    "temporaryDir": "wallpapers&illustration/temporary"
  },
  "naming": {
    "padding": 4,
    "emoticonPadding": 3,
    "allowedExt": ["jpg", "jpeg", "png", "gif", "bmp", "webp", "avif"]
  },
  "dedup": {
    "hammingThreshold": 5,
    "onExactDuplicate": "skip"
  },
  "upload": {
    "maxBatchFiles": 200,
    "maxFileMB": 60,
    "quality": 100
  },
  "git": {
    "enabled": true,
    "timeoutMs": 120000
  },
  "linkFormat": "jsdelivr"
}
